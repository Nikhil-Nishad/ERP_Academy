            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "const existingIndex = $input.item.json.data;\n\nif (!Array.isArray(existingIndex)) {\n  throw new Error('index.json content is not an array');\n}\n\nconst editFields = $('Edit Fields1').item.json;\n\nif (!editFields.slug) {\n  throw new Error('Missing slug from Edit Fields node');\n}\n\nif (existingIndex.some(post => post.slug === editFields.slug)) {\n  throw new Error(`Slug already exists: ${editFields.slug}`);\n}\n\nconst dateStr = new Date().toISOString().split('T')[0];\n\nconst newEntry = {\n  id: editFields.slug,\n  slug: editFields.slug,\n  title: editFields.title,\n  date: dateStr,\n  excerpt: editFields.excerpt,\n  author: 'AI Contributor',\n  imageUrl: `/assets/blog_images/${editFields.slug}.webp`,\n  category: editFields.category,\n  tags: Array.isArray(editFields.tags) ? editFields.tags.filter(Boolean) : [],\n  readTime: $('Edit Fields1').item.json.readTime,\n  views: $('Edit Fields1').item.json.views,\n  likes: $('Edit Fields1').item.json.likes,\n  featured: false,\n  status: 'published'\n};\n\nexistingIndex.unshift(newEntry);\n// existingIndex.push(newEntry);\n\n\nreturn {\n  json: {\n    updatedIndex: JSON.stringify(existingIndex, null, 2),\n    sha: $input.item.json.sha\n  }\n};\n"
            },
